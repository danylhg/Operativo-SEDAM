# Copia este archivo como .env.docker y cambia todos los valores marcados.
POSTGRES_DB=bdsedam
POSTGRES_USER=operaciones
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_LARGA

# Genera una cadena larga y aleatoria; no reutilices la clave actual.
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT
CESIUM_TOKEN=PEGA_AQUI_TU_TOKEN_DE_CESIUM

# El puerto público de la API y de la web servida por la API.
API_PORT=3001
DEFAULT_PASSWORD=1234
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302


# Red SEDAM. La API entra al socket de SEDAM Móvil como un dispositivo más, así no depende
# de que el Bridge SEDAM apunte a esta PC. La serie debe estar registrada en el servidor SEDAM
# (serial_numbers.json) y no la debe usar ningún celular: el servidor rechaza al segundo que entre.
SEDAM_SOCKET_URL=https://10.255.255.66:3000
SEDAM_SOCKET_SERIAL=
# 1 = aceptar cualquier certificado (solo si SEDAM cambió el suyo y el panel dice "certificado no válido").
SEDAM_SOCKET_INSECURE=
