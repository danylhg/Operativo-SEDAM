<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mapToolsOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginBottom="64dp" android:clipChildren="true" android:elevation="20dp">
    <ImageButton android:id="@+id/btnMapToolsDrawer" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="top|start" android:layout_marginStart="10dp" android:layout_marginTop="12dp" android:background="@drawable/bg_object_tools_button" android:contentDescription="Abrir herramientas del mapa" android:padding="10dp" android:src="@drawable/ic_menu_bars" android:tint="#F8FAFC" />
    <ScrollView android:id="@+id/mapToolsDrawer" android:layout_width="240dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="@drawable/bg_map_drawer" android:clipToPadding="true" android:fillViewport="true" android:overScrollMode="ifContentScrolls" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="18dp" android:paddingEnd="14dp" android:paddingBottom="32dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="Logo SEDAM" android:src="@drawable/logo_sedam_sinfondo" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEDAM MÓVIL" android:textColor="#F8FAFC" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvMapDrawerUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="#F3C84B" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:id="@+id/btnCloseMapToolsDrawer" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Cerrar herramientas" android:gravity="center" android:text="×" android:textColor="#F3C84B" android:textSize="22sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#24415F" />

            <TextView style="@style/MapDrawerSection" android:text="CAPA DE MAPA" />
            <LinearLayout style="@style/MapDrawerRow"><TextView android:id="@+id/btnLayerMap" style="@style/MapDrawerButton" android:drawableStart="@drawable/ic_layer_map" android:drawablePadding="6dp" android:drawableTint="#9BC7F3" android:text="MAPA"/><TextView android:id="@+id/btnLayerSatellite" style="@style/MapDrawerButton" android:layout_marginStart="6dp" android:drawableStart="@drawable/ic_layer_satellite" android:drawablePadding="6dp" android:drawableTint="#9BC7F3" android:text="SATÉLITE"/></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableStart="@drawable/ic_cloud" android:drawablePadding="8dp" android:text="Modo online\nDescarga y accede tiles" android:textColor="#EEF5FF" android:textSize="11sp" android:lineSpacingExtra="3dp"/><Switch android:id="@+id/switchOnlineMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:contentDescription="Modo online"/></LinearLayout>
            <TextView android:id="@+id/btnDownloadArea" style="@style/MapDrawerTextAction" android:drawableStart="@drawable/ic_download_area" android:drawablePadding="8dp" android:text="Descargar área\nGuarda la zona visible"/>

            <View style="@style/MapDrawerDivider"/><TextView style="@style/MapDrawerSection" android:text="MEDICIÓN"/>
            <LinearLayout style="@style/MapDrawerRow"><TextView android:id="@+id/btnMeasureDistance" style="@style/MapDrawerButton" android:drawableStart="@drawable/ic_measure_distance" android:drawablePadding="5dp" android:text="DISTANCIA"/><TextView android:id="@+id/btnMeasureArea" style="@style/MapDrawerButton" android:layout_marginStart="6dp" android:drawableStart="@drawable/ic_tool_polygon" android:drawablePadding="5dp" android:text="ÁREA"/></LinearLayout>

            <TextView style="@style/MapDrawerSection" android:text="NAVEGACIÓN"/>
            <TextView android:id="@+id/btnCreateRoute" style="@style/MapDrawerButtonWide" android:drawableStart="@drawable/ic_tool_route" android:drawablePadding="6dp" android:text="CREAR RUTA"/>

            <TextView style="@style/MapDrawerSection" android:text="CAPAS VISUALES"/><TextView android:id="@+id/btnLayerMgrs" style="@style/MapDrawerButtonWide" android:drawableStart="@drawable/ic_grid" android:drawablePadding="6dp" android:text="MGRS"/>
            <LinearLayout style="@style/MapDrawerRow" android:layout_marginTop="6dp"><TextView android:id="@+id/btnLayerGeoMsg" style="@style/MapDrawerButton" android:drawableStart="@drawable/ic_tool_poi" android:drawablePadding="5dp" android:text="GEO-MSG"/><TextView android:id="@+id/btnLayerSectors" style="@style/MapDrawerButton" android:layout_marginStart="6dp" android:drawableStart="@drawable/ic_sectors" android:drawablePadding="5dp" android:text="SECTORES"/></LinearLayout>

            <TextView style="@style/MapDrawerSection" android:text="DIBUJO TÁCTICO"/>
            <LinearLayout style="@style/MapDrawerRow"><TextView android:id="@+id/btnDrawLine" style="@style/MapDrawerButton" android:drawableStart="@drawable/ic_tool_route" android:drawablePadding="5dp" android:text="LÍNEA"/><TextView android:id="@+id/btnDrawZone" style="@style/MapDrawerButton" android:layout_marginStart="6dp" android:drawableStart="@drawable/ic_tool_polygon" android:drawablePadding="5dp" android:text="ZONA"/></LinearLayout>
            <LinearLayout style="@style/MapDrawerRow" android:layout_marginTop="6dp"><TextView android:id="@+id/btnDrawRectangle" style="@style/MapDrawerButton" android:drawableStart="@drawable/ic_rectangle" android:drawablePadding="5dp" android:text="RECTÁNGULO"/><TextView android:id="@+id/btnDrawRadius" style="@style/MapDrawerButton" android:layout_marginStart="6dp" android:drawableStart="@drawable/ic_tool_circle" android:drawablePadding="5dp" android:text="RADIO"/></LinearLayout>
            <TextView android:id="@+id/btnClearMapTools" style="@style/MapDrawerTextAction" android:layout_marginTop="8dp" android:drawableStart="@drawable/ic_clear_drawings" android:drawablePadding="8dp" android:text="Limpiar dibujos\nElimina la medición o dibujo activo"/>

            <View style="@style/MapDrawerDivider"/><TextView style="@style/MapDrawerSection" android:text="ALMACENAMIENTO OFFLINE"/>
            <TextView android:id="@+id/tvOfflineStorage" style="@style/MapDrawerTextAction" android:background="@android:color/transparent" android:clickable="false" android:focusable="false" android:drawableStart="@drawable/ic_storage" android:drawablePadding="8dp" android:text="Uso de almacenamiento\nCalculando porcentaje…"/>
            <ProgressBar android:id="@+id/offlineStorageProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginHorizontal="8dp" android:max="100" android:progress="1" android:progressTint="#F3C84B"/>
            <TextView android:id="@+id/btnClearOfflineMaps" style="@style/MapDrawerTextAction" android:drawableStart="@drawable/ic_clear_drawings" android:drawablePadding="8dp" android:text="Vaciar mapas offline\nLibera espacio"/>
            <View style="@style/MapDrawerDivider"/>
            <TextView android:id="@+id/btnMapDrawerLogout" android:layout_width="match_parent" android:layout_height="48dp" android:background="?attr/selectableItemBackground" android:drawableStart="@drawable/ic_nav_logout" android:drawablePadding="8dp" android:drawableTint="#FF6675" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:text="Cerrar sesión" android:textColor="#FF6675" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
