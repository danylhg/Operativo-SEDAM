<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_geo_msg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Row: Title & Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvSectorsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="NOMBRES DE SECTORES"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/btnCloseSectorsDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:text="✕"
            android:textColor="#9BB0C7"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Subtitle Summary -->
    <TextView
        android:id="@+id/tvSectorsSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="2×2 - 4 sectores"
        android:textColor="#9BB0C7"
        android:textSize="12sp" />

    <!-- Container for dynamic grid of input text boxes -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:id="@+id/containerSectorInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Section Title: TAMAÑO DE CUADRÍCULA -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="TAMAÑO DE CUADRÍCULA"
        android:textColor="#9BB0C7"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!-- Grid Size Selector Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSize2x2"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sector_size_btn_selected"
            android:gravity="center"
            android:text="2×2"
            android:textColor="#F3C84B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSize2x3"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sector_size_btn_normal"
            android:gravity="center"
            android:text="2×3"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSize3x3"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sector_size_btn_normal"
            android:gravity="center"
            android:text="3×3"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSize4x4"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sector_size_btn_normal"
            android:gravity="center"
            android:text="4×4"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <TextView
        android:id="@+id/btnApplySectors"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_apply_btn"
        android:gravity="center"
        android:text="APLICAR Y COMPARTIR"
        android:textColor="#0B1C2E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:id="@+id/btnClearSectors"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_clear_sectors_btn"
        android:gravity="center"
        android:text="LIMPIAR SECTORES"
        android:textColor="#EF4444"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

</LinearLayout>
