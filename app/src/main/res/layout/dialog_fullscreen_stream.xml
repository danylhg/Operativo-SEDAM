<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060C17">

    <!-- Header superior con título, contador y botón de cerrar -->
    <RelativeLayout
        android:id="@+id/headerFullscreen"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#0A1424"
        android:paddingHorizontal="16dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFullscreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Cámara"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFullscreenCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="1/1"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseFullscreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_clear_gray"
            android:tint="#94A3B8"
            android:padding="6dp"
            android:contentDescription="Cerrar pantalla completa" />
    </RelativeLayout>

    <!-- Contenido de Video en Pantalla Completa -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerFullscreen"
        android:background="#000000">

        <!-- Contenedor Nativo WebRTC -->
        <FrameLayout
            android:id="@+id/fullscreenNativeContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- WebView HLS Stream Player -->
        <WebView
            android:id="@+id/fullscreenWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

        <!-- Vista Esperando Señal -->
        <LinearLayout
            android:id="@+id/fullscreenWaitingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFullscreenWaitingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_map_drawer_action"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="ESPERANDO SEÑAL"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Overlay transparente superior para capturar deslices horizontales y doble toque -->
        <View
            android:id="@+id/fullscreenTouchOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:background="@android:color/transparent" />

    </FrameLayout>

</RelativeLayout>
