<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0f1e">
    <TextView
        android:id="@+id/connectionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B71C1C"
        android:elevation="12dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Se perdio la conexion con el servidor."
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Mapa Cesium — pantalla completa -->
    <WebView
        android:id="@+id/cesiumWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <include layout="@layout/panel_map_tools" />

    <!-- Barra de herramientas de dibujo libre (flotante, esquina superior derecha) -->
    <LinearLayout
        android:id="@+id/drawingToolbar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:elevation="10dp"
        android:background="#CC0d1526"
        android:padding="6dp">

        <TextView
            android:id="@+id/btnPencil"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✏️"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/btnEraser"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="🧹"
            android:textSize="22sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/objectToolsContainer"
        android:visibility="gone"
        android:layout_width="286dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:elevation="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/objectToolsMenu"
            android:layout_width="208dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_object_tools_menu"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:padding="8dp"
            android:scrollbarStyle="insideInset"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text=""
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/objectToolSelection"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text=""
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="3dp"
                    android:text="DIBUJO LIBRE"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/itemToolPencil"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Lápiz"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/itemToolEraser"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Goma de borrar"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="3dp"
                    android:text="PUNTOS DE INTERÉS"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/itemToolMil"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Símbolo Militar"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/itemToolPoi"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Puntos de Interés"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="3dp"
                    android:text="ÁREAS DE INTERÉS"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/itemToolPolygon"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Polígono Táctico"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/itemToolCircle"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Círculo de cobertura"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/itemToolRoute"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Ruta"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="3dp"
                    android:text="OTROS"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/itemToolBuilding"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Edificio"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/itemToolLabel"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_object_tools_menu_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Etiqueta"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topRightControlsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:elevation="16dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBluetoothMedia"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_bluetooth_button"
            android:clickable="true"
            android:contentDescription="Bluetooth"
            android:elevation="16dp"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bluetooth"
            android:tint="#F8FAFC" />

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnStreamMedia"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_bluetooth_button"
                android:clickable="true"
                android:contentDescription="Transmitir camara y microfono"
                android:elevation="16dp"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_stream_camera_on"
                android:tint="#F8FAFC" />

            <ImageButton
                android:id="@+id/btnDeleteSelectedMeasurement"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_delete_measurement"
                android:contentDescription="Borrar distancia seleccionada"
                android:elevation="16dp"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_clear_drawings"
                android:tint="#F8FAFC"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/mapDownloadProgressPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_object_tools_menu"
        android:elevation="24dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/mapDownloadProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descargando mapas… 0%"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/mapDownloadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#38BDF8" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawingMiniToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="12dp"
        android:elevation="18dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnMiniPencil"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_map_tool_circle"
            android:contentDescription="Lapiz"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tool_pencil"
            android:tint="#BFE1FF" />

        <ImageButton
            android:id="@+id/btnMiniEraser"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_map_tool_circle"
            android:contentDescription="Goma"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tool_eraser"
            android:tint="#BFE1FF" />

        <LinearLayout
            android:id="@+id/layoutColorOptions"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/colorCyan"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp" />

            <View
                android:id="@+id/colorRed"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp" />

            <View
                android:id="@+id/colorBlue"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp" />

            <View
                android:id="@+id/colorYellow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp" />

            <View
                android:id="@+id/colorPurple"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp" />

            <View
                android:id="@+id/colorWhite"
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnDeleteSelectedObject"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="116dp"
        android:background="@drawable/bg_delete_button"
        android:text="Eliminar"
        android:textAllCaps="false"
        android:textColor="#DDEBFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:minWidth="96dp"
        android:visibility="gone" />

    <!-- Panel inferior deslizable -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#D9050B14"
        android:clickable="true"
        android:elevation="8dp">

        <!-- Handle / drag indicator -->
        <View
            android:id="@+id/panelHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="#475569"
            android:visibility="gone"/>
        <!-- android:clickable="false" eliminado — es el valor por defecto para View -->

        <!-- Contenedor del contenido del panel.
             altura dinámica: wrap_content + maxHeight controlado desde Kotlin con
             panelContent.maxHeight = (resources.displayMetrics.heightPixels * 0.40).toInt()
             Así se adapta a pantallas pequeñas y grandes sin valor fijo. -->
        <FrameLayout
            android:id="@+id/panelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <!-- Barra de navegación inferior (5 botones) -->
        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_bottom_nav_glass"
            android:elevation="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <!-- Botón Operación -->
            <LinearLayout
                android:id="@+id/btnNavOperation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/iconNavOperation"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_operation"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Operación"
                    android:textColor="#64748b"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Botón Mensajes -->
            <LinearLayout
                android:id="@+id/btnNavChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="27dp">

                    <ImageView
                        android:id="@+id/iconNavChat"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|start"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_nav_chat"/>

                    <TextView
                        android:id="@+id/chatUnreadBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_chat_unread_badge"
                        android:gravity="center"
                        android:minWidth="18dp"
                        android:paddingHorizontal="5dp"
                        android:textColor="#F2FAF8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"/>
                </FrameLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mensajes"
                    android:textColor="#64748b"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Botón Personal -->
            <LinearLayout
                android:id="@+id/btnNavPersonal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/iconNavPersonal"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_user"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal"
                    android:textColor="#64748b"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Botón Vehículos -->
            <LinearLayout
                android:id="@+id/btnNavVehiculos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/iconNavVehiculos"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_vehicle"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vehículos"

                    android:textColor="#64748b"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- Botón Vehículos/Equipo -->
            <LinearLayout
                android:id="@+id/btnNavEquipos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iconNavEquipos"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_equipment"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Equipos"
                    android:textColor="#64748b"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNavDispositivos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iconNavDispositivos"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_device"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disp."
                    android:textColor="#64748b"
                    android:textSize="10sp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMyLocation"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_fab_location"
        android:clickable="true"
        android:contentDescription="Centrar en mi ubicacion"
        android:elevation="4dp"
        android:focusable="true"
        android:padding="13dp"
        android:scaleType="centerInside"
        android:stateListAnimator="@null"
        android:src="@drawable/ic_crosshair"
        android:tint="#BFE1FF" />

    <TextView
        android:id="@+id/pttAlertBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_ptt_alert_banner"
        android:drawableStart="@drawable/ic_emergency_alert"
        android:drawablePadding="10dp"
        android:drawableTint="#FFFFFF"
        android:elevation="32dp"
        android:gravity="center"
        android:clickable="false"
        android:focusable="false"
        android:maxLines="3"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp"
        android:text="ALERTA DE EMERGENCIA PTT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/directedAlertBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_ptt_alert_banner"
        android:elevation="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Alerta"
            android:src="@drawable/ic_emergency_alert"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvDirectedAlertMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:maxLines="3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDismissDirectedAlert"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
