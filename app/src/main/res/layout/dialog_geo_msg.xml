<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_geo_msg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvGeoMsgTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MENSAJE GEO-ANCLADO"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:id="@+id/tvGeoMsgCoords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Ubicación: 19.04788, -95.97772"
        android:textColor="#F3C84B"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etGeoMsgInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="110dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_geo_msg_input"
        android:gravity="top|start"
        android:hint="Mensaje"
        android:textColorHint="#64748B"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:padding="14dp"
        android:inputType="textMultiLine" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelGeoMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="CANCELAR"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSendGeoMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="ENVIAR"
            android:textColor="#F3C84B"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
