<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Semi-transparent white gradient for glass effect -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#1EFFFFFF"
        android:endColor="#08FFFFFF" />
    <!-- White border (1dp, 17% opacity) -->
    <stroke
        android:width="1dp"
        android:color="#2BFFFFFF" />
    <corners
        android:radius="16dp" />
</shape>
